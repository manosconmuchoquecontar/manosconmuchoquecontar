<style>
:root{--teal:#2a9d8f;--teal-d:#1a7a6e;--teal-l:#4db6a8;--teal-bg:#e8f5f3;--cream:#fdf8f0;--ink:#1c2127;--muted:#6b7280;--border:#e2e8e6;--radius:16px;--radius-s:10px}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Nunito',sans-serif;background:#f4f7f6;color:var(--ink);min-height:100vh;display:flex;flex-direction:column}
nav{background:#fff;border-bottom:1px solid var(--border);padding:0 clamp(.75rem,4vw,2.5rem);height:56px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.nav-logo{font-weight:700;font-size:.92rem;color:var(--teal-d);text-decoration:none;display:flex;align-items:center;gap:6px;white-space:nowrap}
@media(max-width:480px){.nav-logo .logo-txt{display:none}}
.nav-links{display:flex;gap:clamp(.6rem,2vw,1.5rem)}
.nav-links a{font-size:clamp(.78rem,2.5vw,.9rem);font-weight:600;color:var(--muted);text-decoration:none;transition:color .15s;white-space:nowrap}
.nav-links a:hover{color:var(--teal)}
.nav-links a.active{color:var(--teal-d)}
.hero{background:linear-gradient(135deg,var(--teal-d),var(--teal) 55%,var(--teal-l));padding:2.5rem clamp(1rem,4vw,2.5rem) 2rem;text-align:center;color:#fff}
