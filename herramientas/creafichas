.panel{background:#fff;border-radius:var(--radius);border:1.5px solid var(--border);padding:1.25rem 1.5rem;display:flex;flex-direction:column;gap:.75rem;transition:border-color .2s,box-shadow .2s}
.panel:focus-within{border-color:var(--teal-l);box-shadow:0 0 0 3px rgba(42,157,143,.1)}
.panel-header{display:flex;align-items:center;justify-content:space-between}
.panel-title{font-size:.82rem;font-weight:700;color:var(--teal-d);display:flex;align-items:center;gap:6px}
.panel-title::before{content:'';display:block;width:8px;height:8px;border-radius:50%;background:var(--teal)}
