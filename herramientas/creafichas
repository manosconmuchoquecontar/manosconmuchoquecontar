.hero h1{font-family:'Fraunces',serif;font-size:clamp(1.6rem,5vw,2.6rem);font-weight:700;line-height:1.15;margin-bottom:.6rem}
.hero h1 em{font-style:italic;color:rgba(255,255,255,.82)}
.hero p{font-size:.95rem;color:rgba(255,255,255,.82);max-width:540px;margin:0 auto;line-height:1.7}
main{flex:1;max-width:1000px;width:100%;margin:0 auto;padding:1.75rem clamp(1rem,4vw,1.5rem) 3rem;display:flex;flex-direction:column;gap:1.25rem}
.section-label{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:.6rem}
.chips{display:flex;flex-wrap:wrap;gap:.6rem}
.chip{cursor:pointer;border:2px solid var(--border);border-radius:50px;padding:8px 18px;font-family:'Nunito',sans-serif;font-size:.85rem;font-weight:600;background:#fff;color:var(--muted);transition:all .15s;user-select:none}
.chip:hover{border-color:var(--teal);color:var(--teal)}
