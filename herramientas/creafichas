.espacio-resp{margin-top:.75rem;border-bottom:1.5px dashed #c3d9d5;height:32px}
.badge{display:inline-flex;align-items:center;gap:4px;font-size:.72rem;font-weight:700;padding:3px 10px;border-radius:20px;text-transform:uppercase;letter-spacing:.05em}
