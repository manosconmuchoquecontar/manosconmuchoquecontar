document.getElementById('btn-generar').addEventListener('click', async()=>{
  const descripcion=document.getElementById('descripcion').value.trim();
  if(!descripcion){
    const ta=document.getElementById('descripcion');
    ta.focus();
    ta.style.outline='2px solid #ef4444';
    setTimeout(()=>ta.style.outline='none',1500);
    return;
  }
  const curso=document.getElementById('select-curso').value;
  const asignatura=document.getElementById('select-asignatura').value;
  const btn=document.getElementById('btn-generar');
  const out=document.getElementById('output-content');

  btn.disabled=true;
  btn.innerHTML='<span class="spinner"></span> Generando ficha…';
  document.getElementById('btn-ficha').style.display='none';

  out.innerHTML='<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:260px;gap:12px"><div style="width:36px;height:36px;border:3px solid var(--border);border-top-color:var(--teal);border-radius:50%;animation:spin .65s linear infinite"></div><span style="font-size:.85rem;color:var(--muted)">Generando ficha con IA…</span></div>';

  try{
    const prompt=getPrompt(descripcion, perfil, curso, asignatura);
    let resultado='';
    try{resultado=await llamarGemini(prompt);}
    catch{resultado=await llamarGroq(prompt);}
    renderizar(resultado, perfil);
    actualizarBadge();
  } catch(err){
    out.innerHTML='<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:160px;gap:8px;text-align:center"><span style="font-size:1.8rem">⚠️</span><strong style="color:#dc2626;font-size:.9rem">Error al conectar con la IA</strong><span style="font-size:.78rem;color:var(--muted)">'+err.message+'</span></div>';
  } finally{
    btn.disabled=false;
    btn.innerHTML='<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> Generar ficha';
  }
});

