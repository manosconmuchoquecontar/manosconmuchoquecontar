<script>
const GEMINI_KEY='AIzaSyC2zoebLg8S7Cv6Hsv9vny8dJ8yVJrlI1Q';
const GEMINI_MODEL='gemini-2.5-flash-preview-04-17';
const GROQ_KEY='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';

let perfil='TEA';

// Chips perfil
document.querySelectorAll('#chips-perfil .chip').forEach(c=>{
  c.addEventListener('click',()=>{
    document.querySelectorAll('#chips-perfil .chip').forEach(x=>x.classList.remove('active'));
    c.classList.add('active');
