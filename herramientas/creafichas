const BADGES={TEA:{label:'🧩 TEA',cls:'badge-TEA'},DI:{label:'🌟 DI',cls:'badge-DI'},TDAH:{label:'⚡ TDAH',cls:'badge-TDAH'},DISLEXIA:{label:'📖 Dislexia',cls:'badge-DISLEXIA'},BAJAVISION:{label:'👁️ Baja Visión',cls:'badge-BAJAVISION'}};

function actualizarBadge(){
  const b=document.getElementById('badge-perfil');
  b.textContent=BADGES[perfil].label;
  b.className='badge '+BADGES[perfil].cls;
}

document.getElementById('btn-print').addEventListener('click',()=>window.print());

function getPrompt(descripcion, perfil, curso, asignatura){
  const perfilTextos={
    TEA:`PERFIL: Alumno con TEA.
REGLAS:
• Instrucciones literales, sin metáforas ni doble sentido.
• Máximo 7 palabras por instrucción.
• Pasos numerados con sub-pasos 1.1, 1.2... con →
• Verbo imperativo al inicio de cada paso.
• Espacios de respuesta marcados con líneas de puntos (...............).
• Si el ejercicio tiene ejemplos, ponlos entre paréntesis.`,

    DI:`PERFIL: Alumno con Discapacidad Intelectual — Lectura Fácil.
REGLAS:
• Instrucción muy corta: máximo 6 palabras. Verbo + qué hacer.
• Emoji al inicio de cada instrucción.
• Siempre incluye un ejemplo resuelto entre paréntesis.
• Frases del ejercicio en líneas separadas.
• Espacios de respuesta amplios con líneas de puntos.
• Vocabulario muy sencillo. Sin tecnicismos.`,

    TDAH:`PERFIL: Alumno con TDAH.
REGLAS:
• **Negrita** en el verbo de acción y la palabra clave.
• ✅ al inicio de cada ejercicio distinto.
• Ejercicios variados, cortos y dinámicos.
• Instrucción máximo 2 líneas.
• Al final añade: "📋 ¿Has contestado todos los ejercicios?"
• Alterna tipos: rodear, unir con flechas, completar, ordenar.`,

    DISLEXIA:`PERFIL: Alumno con Dislexia.
REGLAS:
• Frases cortas: máximo 10 palabras. Una idea por frase.
• Guiones para separar pasos, no párrafos.
• Palabras simples. Sin tecnicismos.
• Solo mayúscula al inicio de frase.
• Espacios de respuesta con líneas de puntos amplias.
• Interlineado generoso entre elementos.`,

    BAJAVISION:`PERFIL: Alumno con Baja Visión.
REGLAS:
• Frases muy cortas: máximo 6 palabras por línea.
• Una instrucción por línea. Estructura vertical.
• Numeración muy visible en negrita: **1.** **2.**
• Sin abreviaturas ni símbolos raros.
• Espacios de respuesta muy amplios.
• Sin información decorativa innecesaria.`
  };

  return `Eres experta en adaptación curricular y necesidades educativas especiales. Trabajas en España con el currículo LOMLOE.

TAREA: Genera una ficha de trabajo con exactamente 5 ejercicios.

DATOS DE LA FICHA:
- Curso: ${curso}
- Asignatura: ${asignatura}
- Tema/contenido a trabajar: ${descripcion}

${perfilTextos[perfil]}

FORMATO DE SALIDA — sigue este formato exactamente:
**1.** [Título breve del ejercicio]
[Instrucción adaptada al perfil]
[Contenido del ejercicio con espacios de respuesta]

**2.** [Título breve del ejercicio]
...

(Repite para los 5 ejercicios)

IMPORTANTE:
- Los 5 ejercicios deben ser VARIADOS en formato (completar, rodear, unir, ordenar, escribir, etc.)
- Ajusta el nivel de dificultad al curso indicado.
- Los espacios de respuesta se marcan con ............... o líneas en blanco.
- No uses asteriscos para nada que no sea negrita.
- Devuelve ÚNICAMENTE los ejercicios. Sin explicaciones ni comentarios previos.`;
}

async function llamarGemini(prompt){
  const res=await fetch('https://generativelanguage.googleapis.com/v1beta/models/'+GEMINI_MODEL+':generateContent?key='+GEMINI_KEY,{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({contents:[{parts:[{text:prompt}]}],generationConfig:{maxOutputTokens:2500,temperature:0.4}})
  });
  if(!res.ok){const e=await res.json().catch(()=>({}));throw new Error(e.error?.message||'Error Gemini '+res.status);}
  const d=await res.json();
  return d.candidates?.[0]?.content?.parts?.[0]?.text?.trim()||'';
}

async function llamarGroq(prompt){
  const res=await fetch('https://api.groq.com/openai/v1/chat/completions',{
    method:'POST',
    headers:{'Content-Type':'application/json','Authorization':'Bearer '+GROQ_KEY},
    body:JSON.stringify({model:'llama-3.3-70b-versatile',max_tokens:2500,temperature:0.4,messages:[{role:'user',content:prompt}]})
  });
  if(!res.ok)throw new Error('Error Groq '+res.status);
  const d=await res.json();
  return d.choices?.[0]?.message?.content?.trim()||'';
}

function renderizar(texto, p){
  const el=document.getElementById('output-content');
  const bloques=texto.split(/\n{2,}/).filter(b=>b.trim());
  let html='<div class="ejercicios-wrap out-'+p+'">';

  bloques.forEach(bloque=>{
    const lineas=bloque.split('\n').filter(l=>l.trim());
    const esRecordatorio=lineas.length===1&&lineas[0].includes('📋');
    if(esRecordatorio){
      html+='<div style="background:#fff8e8;border:1.5px solid #f0d98a;border-radius:10px;padding:.75rem 1rem;margin-top:.5rem;font-size:.88rem;font-weight:600;color:#8a6800;">'+lineas[0]+'</div>';
      return;
    }
    html+='<div class="ejercicio-bloque">';
    lineas.forEach(linea=>{
      const proc=linea.replace(/\*\*(.*?)\*\*/g,(_,t)=>
        p==='TDAH'
          ?'<strong style="color:#c85a00;background:#fff0e0;padding:1px 5px;border-radius:3px;">'+t+'</strong>'
          :'<strong>'+t+'</strong>'
      );
      if(/^\*\*\d+[\.\d]*\*\*/.test(linea.trim())){
        html+='<p class="ej-titulo">'+proc+'</p>';
      } else if(linea.trim().startsWith('→')){
        html+='<div class="step-row"><span class="step-arrow">→</span><span class="ej-linea" style="margin:0">'+proc.replace(/^→\s*/,'')+'</span></div>';
      } else if(linea.trim().startsWith('-')){
        html+='<div class="step-row"><span class="step-arrow" style="color:var(--muted)">–</span><span class="ej-linea" style="margin:0">'+proc.replace(/^-\s*/,'')+'</span></div>';
      } else {
        html+='<p class="ej-linea">'+proc+'</p>';
      }
    });
    html+='<div class="espacio-resp"></div></div>';
  });
  html+='</div>';
  el.innerHTML=html;

  const btn=document.getElementById('btn-ficha');
  btn.style.display='flex';
  const t=document.getElementById('salida-title');
  t.classList.remove('muted');
  t.style.color='var(--teal-d)';
}

